# Developer settings > API Keys (used as HTTP Basic auth; required for private datasets)
SOCRATA_API_KEY_ID=your-api-key-id
SOCRATA_API_KEY_SECRET=your-api-key-secret

# Developer settings > App Tokens (identifies the app for rate limits)
SOCRATA_APP_TOKEN=your-app-token

# Comma-separated dataset IDs (the xxxx-xxxx in each dataset's URL)
CIM_DATASET_IDS=abcd-1234,efgh-5678

# ArcGIS Online: a built-in account (not SSO). Used to get a token on the server.
ARCGIS_USERNAME=your-arcgis-username
ARCGIS_PASSWORD=your-arcgis-password

# Comma-separated ArcGIS item IDs (the id=… in each item's URL)
ARCGIS_ITEM_IDS=0123456789abcdef0123456789abcdef
